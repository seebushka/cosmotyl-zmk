#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            sensor-bindings = <&inc_dec_kp N8 N9>;

            bindings = <
                &none &none &none &none &none &none &none   &kp A  &kp B  &kp C  &kp D  &kp E  &kp F  &kp G  &kp H
                &none &none &none &none &none &none &none   &kp I  &kp J  &kp K  &kp L  &kp M  &kp N  &kp O  &kp P
                &none &none &none &none &none &none &none   &kp Q  &kp R  &kp S  &kp T  &kp U  &kp V  &kp W  &kp X
                &none &none &none &none &none &none &none   &kp Y  &kp Z  &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &kp N6
                &none &none &none &none &none &none &none   &kp N7 &kp N8 &kp N9 &kp N0 &kp MINUS &kp EQUAL &kp LBKT &kp RBKT
            >;
        };
    };
};
