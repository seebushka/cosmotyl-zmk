#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/modifiers.h>

#define SPACE_LAYER 1

/ {
    behaviors {
        gnome_home: gnome_home {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <250>;
            bindings = <&kp F24>, <&kp LC(LS(LA(A)))>;
        };

        /* Canary-style Ctrl shortcut morphs */
        ctrl_t: ctrl_t {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp T>, <&kp F13>;
            mods = <(MOD_LCTL | MOD_RCTL)>;
        };
        ctrl_r: ctrl_r {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp R>, <&kp F14>;
            mods = <(MOD_LCTL | MOD_RCTL)>;
        };
        ctrl_s: ctrl_s {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp S>, <&kp F15>;
            mods = <(MOD_LCTL | MOD_RCTL)>;
        };
        ctrl_y: ctrl_y {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp Y>, <&kp F16>;
            mods = <(MOD_LCTL | MOD_RCTL)>;
        };
        ctrl_k: ctrl_k {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp K>, <&kp F17>;
            mods = <(MOD_LCTL | MOD_RCTL)>;
        };
        ctrl_g: ctrl_g {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp G>, <&kp DEL>;
            mods = <(MOD_LCTL | MOD_RCTL)>;
        };
        ctrl_5: ctrl_5 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N5>, <&kp F5>;
            mods = <(MOD_LCTL | MOD_RCTL)>;
        };
        ctrl_4: ctrl_4 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N4>, <&kp F4>;
            mods = <(MOD_LCTL | MOD_RCTL)>;
        };
        ctrl_3: ctrl_3 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N3>, <&kp F3>;
            mods = <(MOD_LCTL | MOD_RCTL)>;
        };
        ctrl_2: ctrl_2 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N2>, <&kp F2>;
            mods = <(MOD_LCTL | MOD_RCTL)>;
        };
        ctrl_1: ctrl_1 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N1>, <&kp F1>;
            mods = <(MOD_LCTL | MOD_RCTL)>;
        };
        ctrl_v: ctrl_v {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp V>, <&kp F22>;
            mods = <(MOD_LCTL | MOD_RCTL)>;
        };
        ctrl_b: ctrl_b {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp B>, <&kp F23>;
            mods = <(MOD_LCTL | MOD_RCTL)>;
        };
        ctrl_w: ctrl_w {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp W>, <&kp LC(X)>;
            mods = <(MOD_LCTL | MOD_RCTL)>;
        };
        ctrl_q: ctrl_q {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp Q>, <&kp LC(V)>;
            mods = <(MOD_LCTL | MOD_RCTL)>;
        };
        ctrl_l: ctrl_l {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp L>, <&kp LC(A)>;
            mods = <(MOD_LCTL | MOD_RCTL)>;
        };
        ctrl_d: ctrl_d {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp D>, <&kp LC(Z)>;
            mods = <(MOD_LCTL | MOD_RCTL)>;
        };

        /* Ctrl variants for navigation/symbol keys */
        ctrl_esc: ctrl_esc {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp ESC>, <&kp TAB>;
            mods = <(MOD_LCTL | MOD_RCTL)>;
        };
        ctrl_pgup: ctrl_pgup {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp PG_UP>, <&kp HOME>;
            mods = <(MOD_LCTL | MOD_RCTL)>;
        };
        ctrl_pgdn: ctrl_pgdn {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp PG_DN>, <&kp END>;
            mods = <(MOD_LCTL | MOD_RCTL)>;
        };
        ctrl_minus: ctrl_minus {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp MINUS>, <&kp LS(MINUS)>;
            mods = <(MOD_LCTL | MOD_RCTL)>;
        };
        ctrl_plus: ctrl_plus {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LS(EQUAL)>, <&kp EQUAL>;
            mods = <(MOD_LCTL | MOD_RCTL)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            /* Encoder: clockwise volume up, counterclockwise volume down */
            sensor-bindings = <&inc_dec_kp LC(LS(LA(PG_UP))) LC(LS(LA(PG_DN)))>;

            bindings = <
                /* MATRIX ROW 0 */
                /* LEFT:  `     5     4     3     2     1     SOUND */
                &kp GRAVE &ctrl_5 &ctrl_4 &ctrl_3 &ctrl_2 &ctrl_1 &kp F21
                /* RIGHT: \     ]     [     CTRL+SHIFT CTRL  ENTER .     SHIFT */
                &kp BSLH &kp RBKT &kp LBKT &kp LC(LSHFT) &kp LCTRL &kp ENTER &kp DOT &kp LSHFT

                /* MATRIX ROW 1 */
                /* LEFT:  TAB   W     L     Y     P     B     LIGHT */
                &kp TAB &ctrl_w &ctrl_l &ctrl_y &kp P &ctrl_b &kp F19
                /* RIGHT: SPACE unused ,     BSPC  X     H     unused / */
                &lt SPACE_LAYER SPACE &none &kp COMMA &kp BSPC &kp X &kp H &none &kp SLASH

                /* MATRIX ROW 2 */
                /* LEFT:  PGUP  C     R     S     T     G     REPLAY */
                &ctrl_pgup &kp C &ctrl_r &ctrl_s &ctrl_t &ctrl_g &kp LA(F10)
                /* RIGHT: unused A     I     REC   M     N     ;     E */
                &none &kp A &kp I &kp LA(F9) &kp M &kp N &kp SEMI &kp E

                /* MATRIX ROW 3 */
                /* LEFT:  unused SPACE J     V     D     K     BSPC */
                &none &lt SPACE_LAYER SPACE &kp J &ctrl_v &ctrl_d &ctrl_k &kp BSPC
                /* RIGHT: unused '     U     ARM   Z     F     -     O */
                &none &kp SQT &kp U &kp LC(LS(LA(Q))) &kp Z &kp F &ctrl_minus &kp O

                /* MATRIX ROW 4 */
                /* LEFT:  PGDN  Q     GNOME ESC   SHIFT ENTER CTRL */
                &ctrl_pgdn &ctrl_q &gnome_home &ctrl_esc &kp LSHFT &kp ENTER &kp LCTRL
                /* RIGHT: unused 0     9     A1    6     7     +     8 */
                &none &kp N0 &kp N9 &kp F20 &kp N6 &kp N7 &ctrl_plus &kp N8
            >;
        };

        space_layer {
            bindings = <
                /* MATRIX ROW 0 */
                /* LEFT:  `     5->6  4->7  3->8  2->9  1->0  SOUND */
                &trans &kp N6 &kp N7 &kp N8 &kp N9 &kp N0 &trans
                /* RIGHT */
                &trans &trans &trans &trans &trans &trans &trans &trans

                /* MATRIX ROW 1 */
                /* LEFT:  TAB   W     L     Y->UP P->.  B     LIGHT */
                &trans &trans &trans &kp UP &kp DOT &trans &trans
                /* RIGHT */
                &trans &trans &trans &trans &trans &trans &trans &trans

                /* MATRIX ROW 2 */
                /* LEFT:  PGUP  C     R->LEFT S->DOWN T->RIGHT G(no special) REPLAY */
                &trans &trans &kp LEFT &kp DOWN &kp RIGHT &trans &trans
                /* RIGHT: unused A     I->RIGHT REC   M     N->LEFT ;     E->DOWN */
                &trans &trans &kp RIGHT &trans &trans &kp LEFT &trans &kp DOWN

                /* MATRIX ROW 3 */
                /* LEFT */
                &trans &trans &trans &trans &trans &trans &trans
                /* RIGHT: unused '     U     ARM   Z     F     -->)  O->UP */
                &trans &trans &trans &trans &trans &trans &kp LS(N0) &kp UP

                /* MATRIX ROW 4 */
                /* LEFT */
                &trans &trans &trans &trans &trans &trans &trans
                /* RIGHT: unused 0     9     A1    6     7     +->(  8 */
                &trans &trans &trans &trans &trans &trans &kp LS(N9) &trans
            >;
        };
    };
};
